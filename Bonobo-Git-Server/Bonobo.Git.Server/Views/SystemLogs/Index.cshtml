@model Bonobo.Git.Server.Controllers.SystemLogsViewModel
@using System.Linq
@{
    ViewBag.Title = "Logs del sistema";
}

<style>
    .logs-shell {
        display: grid;
        grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
        gap: 18px;
        align-items: stretch;
    }

    .logs-files,
    .logs-viewer {
        border: 1px solid rgba(148, 163, 184, 0.24);
        background: rgba(15, 23, 42, 0.62);
        border-radius: 8px;
    }

    .logs-files {
        min-height: 520px;
        padding: 12px;
    }

    .logs-file {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        color: #dbeafe;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .logs-file:hover,
    .logs-file:focus,
    .logs-file.active {
        color: #ffffff;
        text-decoration: none;
        background: rgba(59, 130, 246, 0.22);
        border-color: rgba(96, 165, 250, 0.36);
    }

    .logs-file-meta {
        display: block;
        margin-top: 4px;
        color: rgba(203, 213, 225, 0.72);
        font-size: 0.78rem;
    }

    .logs-viewer {
        min-width: 0;
        overflow: hidden;
    }

    .logs-viewer-header {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.24);
        color: #e2e8f0;
        font-weight: 700;
    }

    .logs-code {
        margin: 0;
        max-height: 72vh;
        overflow: auto;
        border-radius: 0;
        background: #0b1020;
    }

    .logs-code code {
        display: block;
        padding: 16px;
        white-space: pre;
        font-size: 0.86rem;
        line-height: 1.55;
    }

    @@media (max-width: 900px) {
        .logs-shell {
            grid-template-columns: 1fr;
        }

        .logs-files {
            min-height: 0;
        }
    }
</style>

<h1>Logs del sistema</h1>

<div class="logs-shell">
    <aside class="logs-files">
        @if (Model.Files.Any())
        {
            foreach (var file in Model.Files)
            {
                var activeClass = string.Equals(file.Name, Model.SelectedFile, StringComparison.OrdinalIgnoreCase) ? " active" : "";
                <a class="logs-file@activeClass" href="@Url.Action("Index", "SystemLogs", new { file = file.Name })">
                    <i class="fa-solid fa-file-lines"></i>
                    @file.Name
                    <span class="logs-file-meta">@file.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss") · @String.Format("{0:n0}", file.Length) bytes</span>
                </a>
            }
        }
        else
        {
            <span class="logs-file-meta">No hay archivos .txt en @Model.LogDirectory</span>
        }
    </aside>

    <section class="logs-viewer">
        <div class="logs-viewer-header">
            <span>@(Model.SelectedFile ?? "Sin archivo")</span>
            <span>@Model.LogDirectory</span>
        </div>
        <pre class="logs-code"><code class="language-xml">@Html.Raw(Model.XmlLikeContent)</code></pre>
    </section>
</div>

@section scripts {
    <script>
        (function () {
            var blocks = document.querySelectorAll("pre code.language-xml");
            if (!window.hljs || !blocks.length) {
                return;
            }

            for (var i = 0; i < blocks.length; i += 1) {
                if (window.hljs.highlightElement) {
                    window.hljs.highlightElement(blocks[i]);
                } else {
                    window.hljs.highlightBlock(blocks[i]);
                }
            }
        }());
    </script>
}
