@model Bonobo.Git.Server.Controllers.SystemLogsViewModel
@using System.Linq
@{
    ViewBag.Title = "Logs del sistema";
}

<style>
    .logs-shell {
        display: grid;
        grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
        gap: 18px;
        align-items: stretch;
    }

    .logs-files,
    .logs-viewer {
        border: 1px solid rgba(148, 163, 184, 0.24);
        background: rgba(15, 23, 42, 0.62);
        border-radius: 8px;
    }

    .logs-files {
        height: min(68vh, 640px);
        padding: 12px;
        overflow: auto;
    }

    .logs-file {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        color: #dbeafe;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .logs-file:hover,
    .logs-file:focus,
    .logs-file.active {
        color: #ffffff;
        text-decoration: none;
        background: rgba(59, 130, 246, 0.22);
        border-color: rgba(96, 165, 250, 0.36);
    }

    .logs-file-meta {
        display: block;
        margin-top: 4px;
        color: rgba(203, 213, 225, 0.72);
        font-size: 0.78rem;
    }

    .logs-viewer {
        min-width: 0;
        overflow: hidden;
    }

    .logs-viewer-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.24);
        color: #e2e8f0;
        font-weight: 700;
    }

    .logs-viewer-title,
    .logs-viewer-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .logs-viewer-actions {
        flex: 0 0 auto;
        margin-left: auto;
    }

    .logs-viewer-path {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: rgba(226, 232, 240, 0.78);
        font-size: 0.86rem;
    }

    .logs-search {
        width: min(260px, 24vw);
        min-width: 180px;
        height: 36px;
        padding: 7px 10px;
        color: #e2e8f0;
        background: rgba(15, 23, 42, 0.78);
        border: 1px solid rgba(148, 163, 184, 0.36);
        border-radius: 6px;
        outline: none;
    }

    .logs-search:focus {
        border-color: rgba(96, 165, 250, 0.78);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.18);
    }

    .logs-search-count {
        min-width: 58px;
        color: rgba(203, 213, 225, 0.78);
        font-size: 0.82rem;
        text-align: right;
    }

    .logs-download {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: #dbeafe;
        border: 1px solid rgba(148, 163, 184, 0.36);
        border-radius: 6px;
        background: rgba(15, 23, 42, 0.64);
        text-decoration: none;
    }

    .logs-download:hover,
    .logs-download:focus {
        color: #ffffff;
        border-color: rgba(96, 165, 250, 0.72);
        background: rgba(59, 130, 246, 0.24);
        text-decoration: none;
    }

    .logs-code {
        margin: 0;
        height: min(62vh, 590px);
        overflow: auto;
        border-radius: 0;
        background: #0b1020;
        scrollbar-color: rgba(96, 165, 250, 0.72) rgba(15, 23, 42, 0.74);
        scrollbar-width: thin;
    }

    .logs-code code {
        display: block;
        padding: 16px;
        white-space: pre;
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .logs-files::-webkit-scrollbar,
    .logs-code::-webkit-scrollbar {
        width: 12px;
        height: 12px;
    }

    .logs-files::-webkit-scrollbar-track,
    .logs-code::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.74);
    }

    .logs-files::-webkit-scrollbar-thumb,
    .logs-code::-webkit-scrollbar-thumb {
        background: rgba(96, 165, 250, 0.64);
        border: 3px solid rgba(15, 23, 42, 0.74);
        border-radius: 999px;
    }

    .logs-code mark {
        color: #111827;
        background: #fde047;
        border-radius: 3px;
        padding: 0 2px;
    }

    @@media (max-width: 900px) {
        .logs-shell {
            grid-template-columns: 1fr;
        }

        .logs-files {
            height: 220px;
        }

        .logs-viewer-header,
        .logs-viewer-title,
        .logs-viewer-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .logs-search {
            width: 100%;
        }
    }
</style>

<h1>Logs del sistema</h1>

<div class="logs-shell">
    <aside class="logs-files">
        @if (Model.Files.Any())
        {
            foreach (var file in Model.Files)
            {
                var activeClass = string.Equals(file.Name, Model.SelectedFile, StringComparison.OrdinalIgnoreCase) ? " active" : "";
                <a class="logs-file@activeClass" href="@Url.Action("Index", "SystemLogs", new { file = file.Name })">
                    <i class="fa-solid fa-file-lines"></i>
                    @file.Name
                    <span class="logs-file-meta">@file.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss") &middot; @String.Format("{0:n0}", file.Length) bytes</span>
                </a>
            }
        }
        else
        {
            <span class="logs-file-meta">No hay archivos .txt en @Model.LogDirectory</span>
        }
    </aside>

    <section class="logs-viewer">
        <div class="logs-viewer-header">
            <div class="logs-viewer-title">
                <span>@(Model.SelectedFile ?? "Sin archivo")</span>
                <span class="logs-viewer-path">@Model.LogDirectory</span>
            </div>
            <div class="logs-viewer-actions">
                <input id="logSearch" class="logs-search" type="search" placeholder="Buscar en logs" autocomplete="off" />
                <span id="logSearchCount" class="logs-search-count">0</span>
                @if (!string.IsNullOrWhiteSpace(Model.SelectedFile))
                {
                    <a class="logs-download" href="@Url.Action("Download", "SystemLogs", new { file = Model.SelectedFile })" title="Descargar log" aria-label="Descargar log">
                        <i class="fa-solid fa-download"></i>
                    </a>
                }
            </div>
        </div>
        <pre id="logScroll" class="logs-code"><code id="logCode" class="language-xml">@Html.Raw(Model.XmlLikeContent)</code></pre>
    </section>
</div>

@section scripts {
    <script>
        (function () {
            var blocks = document.querySelectorAll("pre code.language-xml");
            if (!window.hljs || !blocks.length) {
                return;
            }

            for (var i = 0; i < blocks.length; i += 1) {
                if (window.hljs.highlightElement) {
                    window.hljs.highlightElement(blocks[i]);
                } else {
                    window.hljs.highlightBlock(blocks[i]);
                }
            }

            var search = document.getElementById("logSearch");
            var count = document.getElementById("logSearchCount");
            var code = document.getElementById("logCode");
            var scroller = document.getElementById("logScroll");

            function clearMarks() {
                var marks = code.querySelectorAll("mark");
                for (var i = marks.length - 1; i >= 0; i -= 1) {
                    var mark = marks[i];
                    mark.parentNode.replaceChild(document.createTextNode(mark.textContent), mark);
                }
                code.normalize();
            }

            function highlightTerm(term) {
                clearMarks();

                if (!term) {
                    count.textContent = "0";
                    return;
                }

                var matches = 0;
                var pattern = term.toLowerCase();
                var walker = document.createTreeWalker(code, NodeFilter.SHOW_TEXT, null, false);
                var nodes = [];
                var node;

                while ((node = walker.nextNode())) {
                    nodes.push(node);
                }

                for (var i = 0; i < nodes.length; i += 1) {
                    var textNode = nodes[i];
                    var text = textNode.nodeValue;
                    var lower = text.toLowerCase();
                    var index = lower.indexOf(pattern);

                    if (index === -1) {
                        continue;
                    }

                    var fragment = document.createDocumentFragment();
                    var cursor = 0;
                    while (index !== -1) {
                        if (index > cursor) {
                            fragment.appendChild(document.createTextNode(text.slice(cursor, index)));
                        }

                        var mark = document.createElement("mark");
                        mark.textContent = text.slice(index, index + term.length);
                        fragment.appendChild(mark);
                        matches += 1;
                        cursor = index + term.length;
                        index = lower.indexOf(pattern, cursor);
                    }

                    if (cursor < text.length) {
                        fragment.appendChild(document.createTextNode(text.slice(cursor)));
                    }

                    textNode.parentNode.replaceChild(fragment, textNode);
                }

                count.textContent = matches.toString();
                var first = code.querySelector("mark");
                if (first && scroller) {
                    scroller.scrollTop = Math.max(0, first.offsetTop - 80);
                }
            }

            if (search && code) {
                search.addEventListener("input", function () {
                    highlightTerm(search.value.trim());
                });
            }
        }());
    </script>
}
