@model Bonobo.Git.Server.Controllers.SystemLogsViewModel
@using System.Linq
@{
    ViewBag.Title = "Logs del sistema";
}

<style>
    .logs-shell {
        display: grid;
        grid-template-columns: minmax(220px, 320px) minmax(0, 1fr);
        gap: 18px;
        align-items: stretch;
    }

    .logs-files,
    .logs-viewer {
        border: 1px solid rgba(148, 163, 184, 0.24);
        background: rgba(15, 23, 42, 0.62);
        border-radius: 8px;
    }

    .logs-files {
        height: min(68vh, 640px);
        padding: 12px;
        overflow: auto;
    }

    .logs-file {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        color: #dbeafe;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .logs-file:hover,
    .logs-file:focus,
    .logs-file.active {
        color: #ffffff;
        text-decoration: none;
        background: rgba(59, 130, 246, 0.22);
        border-color: rgba(96, 165, 250, 0.36);
    }

    .logs-file-meta {
        display: block;
        margin-top: 4px;
        color: rgba(203, 213, 225, 0.72);
        font-size: 0.78rem;
    }

    .logs-viewer {
        min-width: 0;
        overflow: hidden;
    }

    .logs-viewer-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 14px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.24);
        color: #e2e8f0;
        font-weight: 700;
    }

    .logs-viewer-title,
    .logs-viewer-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .logs-viewer-actions {
        flex: 0 0 auto;
        flex-wrap: wrap;
        justify-content: flex-end;
        margin-left: auto;
    }

    .logs-viewer-path {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: rgba(226, 232, 240, 0.78);
        font-size: 0.86rem;
    }

    .logs-search {
        width: min(210px, 18vw);
        min-width: 150px;
        height: 36px;
        padding: 7px 10px;
        color: #e2e8f0;
        background: rgba(15, 23, 42, 0.78);
        border: 1px solid rgba(148, 163, 184, 0.36);
        border-radius: 6px;
        outline: none;
    }

    .logs-search:focus {
        border-color: rgba(96, 165, 250, 0.78);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.18);
    }

    .logs-search-count {
        min-width: 32px;
        color: rgba(203, 213, 225, 0.78);
        font-size: 0.82rem;
        text-align: right;
    }

    .logs-download {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: #dbeafe;
        border: 1px solid rgba(148, 163, 184, 0.36);
        border-radius: 6px;
        background: rgba(15, 23, 42, 0.64);
        text-decoration: none;
    }

    .logs-download:hover,
    .logs-download:focus {
        color: #ffffff;
        border-color: rgba(96, 165, 250, 0.72);
        background: rgba(59, 130, 246, 0.24);
        text-decoration: none;
    }

    .logs-filter {
        display: inline-flex;
        align-items: center;
        height: 34px;
        padding: 0 10px;
        color: #dbeafe;
        background: rgba(15, 23, 42, 0.66);
        border: 1px solid rgba(148, 163, 184, 0.32);
        border-radius: 6px;
        font-weight: 750;
    }

    .logs-filter.active,
    .logs-filter:hover,
    .logs-filter:focus {
        color: #ffffff;
        background: rgba(59, 130, 246, 0.24);
        border-color: rgba(96, 165, 250, 0.62);
    }

    .logs-table-wrap {
        height: 31vh;
        min-height: 230px;
        overflow: auto;
        border-bottom: 1px solid rgba(148, 163, 184, 0.24);
        scrollbar-color: rgba(96, 165, 250, 0.72) rgba(15, 23, 42, 0.74);
        scrollbar-width: thin;
    }

    .logs-table {
        width: 100%;
        border-collapse: collapse;
        color: #e2e8f0;
        table-layout: fixed;
    }

    .logs-table th,
    .logs-table td {
        padding: 10px 12px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.16);
        vertical-align: top;
    }

    .logs-table th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: rgba(15, 23, 42, 0.96);
        color: rgba(226, 232, 240, 0.84);
        font-size: 0.78rem;
        text-transform: uppercase;
    }

    .logs-row {
        cursor: pointer;
    }

    .logs-row:hover,
    .logs-row.active {
        background: rgba(59, 130, 246, 0.14);
    }

    .logs-level {
        display: inline-flex;
        min-width: 74px;
        justify-content: center;
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 800;
    }

    .logs-level.error {
        color: #fecaca;
        background: rgba(185, 28, 28, 0.32);
        border: 1px solid rgba(248, 113, 113, 0.38);
    }

    .logs-level.warning {
        color: #fde68a;
        background: rgba(180, 83, 9, 0.30);
        border: 1px solid rgba(251, 191, 36, 0.38);
    }

    .logs-level.success {
        color: #bbf7d0;
        background: rgba(22, 101, 52, 0.30);
        border: 1px solid rgba(74, 222, 128, 0.36);
    }

    .logs-message-cell {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .logs-detail-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 14px;
        color: rgba(226, 232, 240, 0.88);
        background: rgba(15, 23, 42, 0.48);
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
        font-weight: 800;
    }

    .logs-code {
        margin: 0;
        height: 29vh;
        min-height: 220px;
        overflow: auto;
        border-radius: 0;
        background: #0b1020;
        scrollbar-color: rgba(96, 165, 250, 0.72) rgba(15, 23, 42, 0.74);
        scrollbar-width: thin;
    }

    .logs-code code {
        display: block;
        padding: 16px;
        white-space: pre;
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .logs-table-wrap::-webkit-scrollbar,
    .logs-files::-webkit-scrollbar,
    .logs-code::-webkit-scrollbar {
        width: 12px;
        height: 12px;
    }

    .logs-table-wrap::-webkit-scrollbar-track,
    .logs-files::-webkit-scrollbar-track,
    .logs-code::-webkit-scrollbar-track {
        background: rgba(15, 23, 42, 0.74);
    }

    .logs-table-wrap::-webkit-scrollbar-thumb,
    .logs-files::-webkit-scrollbar-thumb,
    .logs-code::-webkit-scrollbar-thumb {
        background: rgba(96, 165, 250, 0.64);
        border: 3px solid rgba(15, 23, 42, 0.74);
        border-radius: 999px;
    }

    .logs-code mark {
        color: #111827;
        background: #fde047;
        border-radius: 3px;
        padding: 0 2px;
    }

    @@media (max-width: 900px) {
        .logs-shell {
            grid-template-columns: 1fr;
        }

        .logs-files {
            height: 220px;
        }

        .logs-viewer-header,
        .logs-viewer-title,
        .logs-viewer-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .logs-search {
            width: 100%;
        }
    }
</style>

<h1>Logs del sistema</h1>

<div class="logs-shell">
    <aside class="logs-files">
        @if (Model.Files.Any())
        {
            foreach (var file in Model.Files)
            {
                var activeClass = string.Equals(file.Name, Model.SelectedFile, StringComparison.OrdinalIgnoreCase) ? " active" : "";
                <a class="logs-file@activeClass" href="@Url.Action("Index", "SystemLogs", new { file = file.Name })">
                    <i class="fa-solid fa-file-lines"></i>
                    @file.Name
                    <span class="logs-file-meta">@file.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss") &middot; @String.Format("{0:n0}", file.Length) bytes</span>
                </a>
            }
        }
        else
        {
            <span class="logs-file-meta">No hay archivos .txt en @Model.LogDirectory</span>
        }
    </aside>

    <section class="logs-viewer">
        <div class="logs-viewer-header">
            <div class="logs-viewer-title">
                <span>@(Model.SelectedFile ?? "Sin archivo")</span>
                <span class="logs-viewer-path">@Model.LogDirectory</span>
            </div>
            <div class="logs-viewer-actions">
                <button type="button" class="logs-filter active" data-log-filter="all">Todos</button>
                <button type="button" class="logs-filter" data-log-filter="error">Error</button>
                <button type="button" class="logs-filter" data-log-filter="warning">Warning</button>
                <button type="button" class="logs-filter" data-log-filter="success">Success</button>
                <input id="logSearch" class="logs-search" type="search" placeholder="Buscar en logs" autocomplete="off" />
                <span id="logSearchCount" class="logs-search-count">0</span>
                @if (!string.IsNullOrWhiteSpace(Model.SelectedFile))
                {
                    <a class="logs-download" href="@Url.Action("Download", "SystemLogs", new { file = Model.SelectedFile })" title="Descargar log" aria-label="Descargar log">
                        <i class="fa-solid fa-download"></i>
                    </a>
                }
            </div>
        </div>
        <div class="logs-table-wrap">
            <table class="logs-table">
                <thead>
                    <tr>
                        <th style="width: 210px;">Fecha</th>
                        <th style="width: 110px;">Nivel</th>
                        <th>Mensaje</th>
                    </tr>
                </thead>
                <tbody id="logRows">
                    @foreach (var entry in Model.Entries)
                    {
                        var activeClass = entry.Index == 0 ? " active" : "";
                        <tr class="@("logs-row" + activeClass)" data-log-kind="@entry.Kind" data-log-index="@entry.Index" data-log-search="@((entry.Time + " " + entry.Level + " " + entry.Message + " " + entry.Trace).ToLowerInvariant())">
                            <td>@entry.Time</td>
                            <td><span class="logs-level @entry.Kind">@entry.Level</span></td>
                            <td class="logs-message-cell">@entry.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="logs-detail-header">
            <span id="logDetailTitle">Informe completo</span>
            <span id="logVisibleCount">@Model.Entries.Count entradas</span>
        </div>
        <pre id="logScroll" class="logs-code"><code id="logCode" class="language-xml">@(Model.Entries.Any() ? Html.Raw(Model.Entries.First().XmlLikeContent) : Html.Raw(Model.XmlLikeContent))</code></pre>
        <div id="logDetails" hidden>
            @foreach (var entry in Model.Entries)
            {
                <script type="text/plain" data-log-detail="@entry.Index">@Html.Raw(entry.XmlLikeContent)</script>
            }
        </div>
    </section>
</div>

@section scripts {
    <script>
        (function () {
            var blocks = document.querySelectorAll("pre code.language-xml");
            if (!window.hljs || !blocks.length) {
                return;
            }

            for (var i = 0; i < blocks.length; i += 1) {
                if (window.hljs.highlightElement) {
                    window.hljs.highlightElement(blocks[i]);
                } else {
                    window.hljs.highlightBlock(blocks[i]);
                }
            }

            var search = document.getElementById("logSearch");
            var count = document.getElementById("logSearchCount");
            var code = document.getElementById("logCode");
            var scroller = document.getElementById("logScroll");
            var rows = Array.prototype.slice.call(document.querySelectorAll(".logs-row"));
            var filters = Array.prototype.slice.call(document.querySelectorAll("[data-log-filter]"));
            var visibleCount = document.getElementById("logVisibleCount");
            var detailTitle = document.getElementById("logDetailTitle");
            var activeFilter = "all";

            function clearMarks() {
                var marks = code.querySelectorAll("mark");
                for (var i = marks.length - 1; i >= 0; i -= 1) {
                    var mark = marks[i];
                    mark.parentNode.replaceChild(document.createTextNode(mark.textContent), mark);
                }
                code.normalize();
            }

            function highlightTerm(term) {
                clearMarks();

                if (!term) {
                    count.textContent = "0";
                    return;
                }

                var matches = 0;
                var pattern = term.toLowerCase();
                var walker = document.createTreeWalker(code, NodeFilter.SHOW_TEXT, null, false);
                var nodes = [];
                var node;

                while ((node = walker.nextNode())) {
                    nodes.push(node);
                }

                for (var i = 0; i < nodes.length; i += 1) {
                    var textNode = nodes[i];
                    var text = textNode.nodeValue;
                    var lower = text.toLowerCase();
                    var index = lower.indexOf(pattern);

                    if (index === -1) {
                        continue;
                    }

                    var fragment = document.createDocumentFragment();
                    var cursor = 0;
                    while (index !== -1) {
                        if (index > cursor) {
                            fragment.appendChild(document.createTextNode(text.slice(cursor, index)));
                        }

                        var mark = document.createElement("mark");
                        mark.textContent = text.slice(index, index + term.length);
                        fragment.appendChild(mark);
                        matches += 1;
                        cursor = index + term.length;
                        index = lower.indexOf(pattern, cursor);
                    }

                    if (cursor < text.length) {
                        fragment.appendChild(document.createTextNode(text.slice(cursor)));
                    }

                    textNode.parentNode.replaceChild(fragment, textNode);
                }

                count.textContent = matches.toString();
                var first = code.querySelector("mark");
                if (first && scroller) {
                    scroller.scrollTop = Math.max(0, first.offsetTop - 80);
                }
            }

            function setDetail(row) {
                var index = row.getAttribute("data-log-index");
                var detail = document.querySelector("[data-log-detail='" + index + "']");
                if (!detail) {
                    return;
                }

                for (var i = 0; i < rows.length; i += 1) {
                    rows[i].classList.remove("active");
                }
                row.classList.add("active");
                code.innerHTML = detail.textContent;
                detailTitle.textContent = row.cells[0].textContent + " · " + row.cells[1].textContent;

                if (window.hljs) {
                    if (window.hljs.highlightElement) {
                        window.hljs.highlightElement(code);
                    } else {
                        window.hljs.highlightBlock(code);
                    }
                }

                highlightTerm(search ? search.value.trim() : "");
            }

            function applyTableFilters() {
                var term = search ? search.value.trim().toLowerCase() : "";
                var shown = 0;
                var firstVisible = null;

                for (var i = 0; i < rows.length; i += 1) {
                    var row = rows[i];
                    var matchesKind = activeFilter === "all" || row.getAttribute("data-log-kind") === activeFilter;
                    var matchesTerm = !term || row.getAttribute("data-log-search").indexOf(term) !== -1;
                    var visible = matchesKind && matchesTerm;

                    row.style.display = visible ? "" : "none";
                    if (visible) {
                        shown += 1;
                        if (!firstVisible) {
                            firstVisible = row;
                        }
                    }
                }

                visibleCount.textContent = shown + " entradas";
                if (firstVisible && (!document.querySelector(".logs-row.active") || document.querySelector(".logs-row.active").style.display === "none")) {
                    setDetail(firstVisible);
                }
            }

            if (search && code) {
                search.addEventListener("input", function () {
                    applyTableFilters();
                    highlightTerm(search.value.trim());
                });
            }

            for (var i = 0; i < rows.length; i += 1) {
                rows[i].addEventListener("click", function () {
                    setDetail(this);
                });
            }

            for (var j = 0; j < filters.length; j += 1) {
                filters[j].addEventListener("click", function () {
                    activeFilter = this.getAttribute("data-log-filter");
                    for (var k = 0; k < filters.length; k += 1) {
                        filters[k].classList.remove("active");
                    }
                    this.classList.add("active");
                    applyTableFilters();
                });
            }
        }());
    </script>
}
