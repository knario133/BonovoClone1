        /*
           Toastr estructural embebido.
           En algunos despliegues bancarios el archivo toastr.min.css no está presente o queda bloqueado.
           Sin este bloque el JS funciona, pero la notificación queda como un div normal al final del body.
        */
        #toast-container {
            position: fixed !important;
            z-index: 999999 !important;
            pointer-events: none;
        }

            #toast-container.toast-top-right {
                top: 24px !important;
                right: 24px !important;
                left: auto !important;
                bottom: auto !important;
            }

            #toast-container.toast-top-left {
                top: 24px !important;
                left: 24px !important;
                right: auto !important;
                bottom: auto !important;
            }

            #toast-container.toast-bottom-right {
                right: 24px !important;
                bottom: 24px !important;
                top: auto !important;
                left: auto !important;
            }

            #toast-container.toast-bottom-left {
                left: 24px !important;
                bottom: 24px !important;
                top: auto !important;
                right: auto !important;
            }

            #toast-container > div {
                position: relative;
                width: 360px;
                min-height: 72px;
                margin: 0 0 14px 0;
                padding: 16px 18px 16px 52px;
                overflow: hidden;
                color: #ffffff !important;
                border-radius: 16px !important;
                box-shadow: 0 18px 45px rgba(0, 0, 0, 0.40) !important;
                border: 1px solid rgba(255, 255, 255, 0.18) !important;
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                opacity: 0.98 !important;
                pointer-events: auto;
                cursor: default;
            }

                #toast-container > div::before {
                    position: absolute;
                    left: 18px;
                    top: 50%;
                    width: 22px;
                    height: 22px;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    transform: translateY(-50%);
                    font-family: "Segoe UI", Arial, sans-serif;
                    font-weight: 900;
                    font-size: 0.92rem;
                    line-height: 1;
                    color: #ffffff;
                    border: 1px solid currentColor;
                    border-radius: 999px;
                }

            #toast-container > .toast-success {
                background: linear-gradient(135deg, rgba(6, 78, 59, 0.96), rgba(15, 23, 42, 0.94)) !important;
                border-left: 4px solid rgba(52, 211, 153, 0.95) !important;
            }

                #toast-container > .toast-success::before {
                    content: "OK";
                    width: 26px;
                    font-size: 0.72rem;
                    color: #86efac;
                }

            #toast-container > .toast-error {
                background: linear-gradient(135deg, rgba(127, 29, 29, 0.96), rgba(15, 23, 42, 0.94)) !important;
                border-left: 4px solid rgba(251, 113, 133, 0.95) !important;
            }

                #toast-container > .toast-error::before {
                    content: "!";
                    color: #fda4af;
                }

            #toast-container > .toast-info {
                background: linear-gradient(135deg, rgba(12, 74, 110, 0.96), rgba(15, 23, 42, 0.94)) !important;
                border-left: 4px solid rgba(56, 189, 248, 0.95) !important;
            }

                #toast-container > .toast-info::before {
                    content: "i";
                    color: #7dd3fc;
                }

            #toast-container > .toast-warning {
                background: linear-gradient(135deg, rgba(113, 63, 18, 0.96), rgba(15, 23, 42, 0.94)) !important;
                border-left: 4px solid rgba(251, 191, 36, 0.95) !important;
            }

                #toast-container > .toast-warning::before {
                    content: "!";
                    color: #fde68a;
                }

            #toast-container .toast-close-button {
                position: absolute;
                top: 8px;
                right: 10px;
                width: 26px;
                height: 26px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: rgba(255, 255, 255, 0.88) !important;
                background: rgba(255, 255, 255, 0.10) !important;
                border: 1px solid rgba(255, 255, 255, 0.16) !important;
                border-radius: 999px;
                font-size: 1rem;
                line-height: 1;
                text-shadow: none;
                opacity: 1 !important;
                cursor: pointer;
            }

                #toast-container .toast-close-button:hover,
                #toast-container .toast-close-button:focus {
                    color: #ffffff !important;
                    background: rgba(255, 255, 255, 0.18) !important;
                    outline: none;
                }

            #toast-container .toast-title {
                padding-right: 28px;
                font-weight: 800;
                letter-spacing: 0.01em;
            }

            #toast-container .toast-message {
                padding-right: 18px;
                margin-top: 3px;
                font-size: 0.95rem;
                line-height: 1.45;
                color: rgba(255, 255, 255, 0.92) !important;
            }

            #toast-container .toast-progress {
                display: none !important;
            }

        .page-transition-loader {
            position: fixed;
            inset: 0;
            z-index: 9000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: rgba(2, 6, 23, 0.58);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            opacity: 0;
            pointer-events: none;
            transition: opacity 180ms ease;
        }

        body.is-page-loading .page-transition-loader {
            opacity: 1;
            pointer-events: auto;
        }

        .page-transition-loader-card {
            width: min(360px, calc(100vw - 48px));
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 18px 20px;
            color: #eff6ff;
            background: rgba(15, 23, 42, 0.84);
            border: 1px solid rgba(147, 197, 253, 0.32);
            border-radius: 16px;
            box-shadow: 0 24px 64px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.08);
        }

        .page-transition-loader-spinner {
            position: relative;
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            border-radius: 50%;
            background: conic-gradient(from 0deg, rgba(96, 165, 250, 0.1), #60a5fa, #34d399, rgba(96, 165, 250, 0.1));
            animation: pageLoaderSpin 850ms linear infinite;
        }

            .page-transition-loader-spinner::after {
                content: "";
                position: absolute;
                inset: 5px;
                border-radius: 50%;
                background: #0f172a;
                box-shadow: inset 0 0 0 1px rgba(147, 197, 253, 0.18);
            }

        .page-transition-loader-title {
            display: block;
            margin-bottom: 2px;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 800;
        }

        .page-transition-loader-text {
            display: block;
            color: rgba(219, 234, 254, 0.78);
            font-size: 0.86rem;
            line-height: 1.35;
        }

        .page-transition-loader-progress {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 3px;
            overflow: hidden;
            background: rgba(15, 23, 42, 0.34);
        }

            .page-transition-loader-progress::before {
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: -35%;
                width: 35%;
                background: linear-gradient(90deg, transparent, #93c5fd, #34d399, transparent);
                animation: pageLoaderBar 1100ms ease-in-out infinite;
            }

        @@keyframes pageLoaderSpin {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes pageLoaderBar {
            0% {
                left: -35%;
            }

            100% {
                left: 100%;
            }
        }

        @@media (max-width: 640px) {
            #toast-container.toast-top-right,
            #toast-container.toast-top-left,
            #toast-container.toast-bottom-right,
            #toast-container.toast-bottom-left {
                top: 14px !important;
                right: 14px !important;
                left: 14px !important;
                bottom: auto !important;
            }

            #toast-container > div {
                width: auto;
            }
        }

        @@media (max-width: 992px) {
            :root {
                --sidebar-width: 100%;
            }

            .app-layout {
                display: block;
            }

            .sidebar-toggle,
            body.sidebar-collapsed .sidebar-toggle {
                top: 76px;
                right: auto;
                left: 0;
                transform: none;
            }

            .app-sidebar {
                position: relative;
                width: 100%;
                height: auto;
                padding: 12px;
            }

            body.sidebar-collapsed .app-sidebar {
                width: 100%;
                height: 0;
                padding-top: 0;
                padding-bottom: 0;
                opacity: 0;
            }

            body.sidebar-collapsed .sidebar-glass {
                transform: translateY(-115%);
            }

            .sidebar-glass {
                min-height: auto;
                border-radius: 20px;
            }

            .sidebar-nav {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .app-content-wrap,
            body.sidebar-collapsed .app-content-wrap {
                padding: 16px 12px 22px 12px;
            }

            .glass-content {
                min-height: auto;
                padding: 18px;
                border-radius: 20px;
            }

                .glass-content h1 {
                    font-size: 1.65rem;
                }

            .view-toolbar {
                display: block;
            }

            .view-actions,
            .form-actions-glass {
                justify-content: flex-start;
                margin-top: 12px;
            }

            .glass-content .pure-control-group {
                grid-template-columns: 1fr;
                gap: 7px;
            }

            .glass-content .pure-form-aligned .pure-control-group label,
            .glass-content .pure-control-group > label {
                margin-top: 0;
            }

            .glass-content .pure-control-group > em,
            .glass-content .pure-control-group > i.fa-info-circle {
                grid-row: auto;
                margin-left: 0;
            }

            .glass-content .pure-control-group > .field-validation-error,
            .glass-content .pure-control-group > .field-validation-valid,
            .glass-content .pure-control-group > sup,
            .glass-content .pure-form.detail .git-url-text,
            .glass-content .pure-form.detail .personal-url-text {
                grid-column: 1;
            }
        }

        @@media (max-width: 576px) {
            .sidebar-nav {
                grid-template-columns: 1fr;
            }

            .brand-title {
                font-size: 0.96rem;
            }

            .table-glass-wrap table {
                min-width: 620px;
            }
        }
    </style>
</head>
<body class="@HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString() @HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString()">
    <div class="page-transition-loader" id="pageTransitionLoader" role="status" aria-live="polite" aria-hidden="true">
        <div class="page-transition-loader-card">
            <span class="page-transition-loader-spinner" aria-hidden="true"></span>
            <span>
                <span class="page-transition-loader-title">Cargando</span>
                <span class="page-transition-loader-text">Preparando la siguiente vista...</span>
            </span>
        </div>
        <span class="page-transition-loader-progress" aria-hidden="true"></span>
    </div>
    <div id="bg" class="app-layout">
        <button type="button" class="sidebar-toggle" id="sidebarToggle" aria-label="Ocultar menú" aria-expanded="true" title="Ocultar menú">
            <i class="fa-solid fa-bars"></i>
        </button>

        <aside class="app-sidebar">
            <div class="sidebar-glass">
                <div class="brand-wrap">
                    <span class="app-brand-logo" aria-hidden="true">
                        <i class="fa-brands fa-git-alt"></i>
                    </span>
                    <a class="brand-title" href="@Url.Action("Index", "Home")">@UserConfiguration.Current.GetSiteTitle()</a>
                </div>

                @if (Request.IsAuthenticated)
                {
                    var items = (IEnumerable<SelectListItem>)Html.ViewBag.PermittedRepositories;
                    <div class="repo-selector">
                        <label class="glass-label" for="Repositories">Repositorio</label>
                        @Html.DropDownList("Repositories", items, Resources.Repository_Go_To_Dropdown, new { @class = "repositories form-select glass-select", onchange = "location.href=this.options[this.selectedIndex].value;" })
                    </div>
                }

                <div class="sidebar-section-title">Navegación</div>
                <ul class="nav nav-pills flex-column sidebar-nav">
                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Repository")" class="nav-link repository">
                                <i class="fa-solid fa-code-branch"></i>
                                <span>@Resources.Layout_Repositories</span>
                            </a>
                        </li>
                    }

                    @if (User.IsInRole(Definitions.Roles.Administrator))
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Account")" class="nav-link users">
                                <i class="fa-solid fa-user-gear"></i>
                                <span>@Resources.Layout_AdministrationUsers</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Team")" class="nav-link teams">
                                <i class="fa-solid fa-users"></i>
                                <span>@Resources.Layout_AdministrationTeams</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Settings")" class="nav-link settings">
                                <i class="fa-solid fa-gears"></i>
                                <span>@Resources.Layout_AdministrationGlobalSettings</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "SystemLogs")" class="nav-link logs">
                                <i class="fa-solid fa-file-lines"></i>
                                <span>Logs</span>
                            </a>
                        </li>
                    }
                </ul>

                <div class="sidebar-divider"></div>
                <div class="sidebar-section-title">Sesión</div>
                <ul class="nav nav-pills flex-column sidebar-nav">
                    @if (Request.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Edit", "Account", new { id = User.Id() })" class="nav-link">
                                <i class="fa-solid fa-user"></i>
                                <span>@User.DisplayName()</span>
                            </a>
                        </li>

                        if (!User.IsWindowsAuthenticated())
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("LogOff", "Home")" class="nav-link">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    <span>@Resources.Layout_LogOff</span>
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("LogOn", "Home")" class="nav-link">
                                <i class="fa-solid fa-right-to-bracket"></i>
                                <span>@Resources.Layout_LogOn</span>
                            </a>
                        </li>

                        if (UserConfiguration.Current.AllowAnonymousRegistration)
                        {
                            <li class="nav-item">
                                <a href="@Url.Action("Create", "Account")" class="nav-link">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                    <span>@Resources.Layout_Register</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </aside>

        <main class="app-main">
            <div class="app-content-wrap" id="@ViewContext.ViewData["PageID"]">
                <section class="glass-content">
                    @RenderBody()
                </section>
            </div>

            <footer class="app-footer">
                <p>
                    @if (UserConfiguration.Current.HasSiteFooterMessage)
                    {
                        @UserConfiguration.Current.SiteFooterMessage
                        @:&middot;
                    }
                    Bonobo Git Server (@Html.AssemblyVersion()) &copy; 2019 <a href="http://www.chodounsky.net">Jakub Chodounský</a><br />
                    Bonobo Git Server (@Html.AssemblyVersion()) &copy; 2026 <a href="https://github.com/knario133/BonovoClone1">Francisco Castro</a>
                    &middot; <a href="http://bonobogitserver.com/">@Resources.Home</a>
                    &middot; <a href="https://github.com/knario133/BonovoClone1">@Resources.Source</a>
                </p>
            </footer>
        </main>
    </div>

    @Scripts.Render("~/bundledJs")

    <script>
        window.jQuery || document.write('<script src="@Url.Content("~/Librerias/JsDatatables/jquery.min.js")"><\/script>');
    </script>
    <script src="@Url.Content("~/Librerias/FontawesomeFree/all.min.js")"></script>
    <script src="@Url.Content("~/Librerias/JsBootstrapBundle/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/Librerias/JsDatatables/jquery.dataTables.min.js")"></script>
    <script src="@Url.Content("~/Librerias/JsSweetalert2/sweetalert2.all.min.js")"></script>
    <script src="@Url.Content("~/Librerias/ToastrJs/toastr.min.js")"></script>

    <script>
        (function () {
            function applyOutlineButtons() {
                var replacements = {
                    "btn-primary": "btn-outline-primary",
                    "btn-secondary": "btn-outline-secondary",
                    "btn-default": "btn-outline-secondary",
                    "btn-success": "btn-outline-success",
                    "btn-danger": "btn-outline-danger",
                    "btn-warning": "btn-outline-warning",
                    "btn-info": "btn-outline-info"
                };

                document.querySelectorAll(".btn").forEach(function (button) {
                    Object.keys(replacements).forEach(function (sourceClass) {
                        if (button.classList.contains(sourceClass)) {
                            button.classList.remove(sourceClass);
                            button.classList.add(replacements[sourceClass]);
                        }
                    });
                });

                document.querySelectorAll(".glass-content input[type='submit']:not(.btn), .glass-content button:not(.btn)").forEach(function (button) {
                    if (button.classList.contains("glass-combobox-toggle") || button.classList.contains("sidebar-toggle")) {
                        return;
                    }

                    button.classList.add("btn", "btn-outline-primary");
                });

                document.querySelectorAll(".pure-button").forEach(function (button) {
                    button.classList.add("btn", "btn-outline-secondary");
                });
            }

            function applyBootstrapFormClasses() {
                document.querySelectorAll(".glass-content input, .glass-content textarea, .glass-content select").forEach(function (field) {
                    var type = (field.getAttribute("type") || "").toLowerCase();

                    if (type === "hidden" || type === "submit" || type === "button") {
                        return;
                    }

                    if (type === "checkbox" || type === "radio") {
                        field.classList.add("form-check-input");
                        return;
                    }

                    if (field.tagName.toLowerCase() === "select") {
                        field.classList.add("form-select");
                    } else {
                        field.classList.add("form-control");
                    }
                });
            }

            function enhanceTables() {
                if (!window.jQuery || !jQuery.fn || !jQuery.fn.DataTable) {
                    return;
                }

                jQuery("table[data-datatable='true'], table.js-datatable").each(function () {
                    var table = jQuery(this);

                    if (jQuery.fn.DataTable.isDataTable(this)) {
                        return;
                    }

                    table.DataTable({
                        pageLength: 25,
                        language: {
                            decimal: ",",
                            thousands: ".",
                            emptyTable: "No hay datos disponibles",
                            info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                            infoEmpty: "Mostrando 0 a 0 de 0 registros",
                            infoFiltered: "(filtrado de _MAX_ registros totales)",
                            lengthMenu: "Mostrar _MENU_ registros",
                            loadingRecords: "Cargando...",
                            processing: "Procesando...",
                            search: "Buscar:",
                            zeroRecords: "No se encontraron resultados",
                            paginate: {
                                first: "Primero",
                                last: "Último",
                                next: "Siguiente",
                                previous: "Anterior"
                            },
                            select: {
                                rows: {
                                    _: "%d filas seleccionadas",
                                    0: "",
                                    1: "1 fila seleccionada"
                                }
                            }
                        }
                    });
                });
            }

            function initSystemToastr() {
                if (!window.toastr) {
                    return;
                }

                toastr.options = {
                    closeButton: true,
                    debug: false,
                    newestOnTop: true,
                    progressBar: false,
                    positionClass: "toast-top-right",
                    preventDuplicates: true,
                    onclick: null,
                    showDuration: "180",
                    hideDuration: "220",
                    timeOut: 0,
                    extendedTimeOut: 0,
                    tapToDismiss: false,
                    showEasing: "swing",
                    hideEasing: "linear",
                    showMethod: "fadeIn",
                    hideMethod: "fadeOut",
                    escapeHtml: true
                };

                var existingContainer = document.getElementById("toast-container");
                if (existingContainer) {
                    existingContainer.classList.remove("toast-top-left", "toast-bottom-left", "toast-bottom-right");
                    existingContainer.classList.add("toast-top-right");
                }

                function normalizeMessage(element) {
                    return (element.textContent || "")
                        .replace(/\s+/g, " ")
                        .trim();
                }

                function toastInfoForElement(element) {
                    if (element.classList.contains("summary-error") ||
                        element.classList.contains("validation-summary-errors") ||
                        element.classList.contains("alert-danger")) {
                        return { type: "error", title: "Atención" };
                    }

                    if (element.classList.contains("alert-warning")) {
                        return { type: "warning", title: "Advertencia" };
                    }

                    if (element.classList.contains("alert-info")) {
                        return { type: "info", title: "Información" };
                    }

                    return { type: "success", title: "Operación exitosa" };
                }

                function showToastFromElement(element) {
                    if (!element || element.dataset.toastrProcessed === "true") {
                        return;
                    }

                    element.dataset.toastrProcessed = "true";

                    var message = normalizeMessage(element);
                    var toastInfo = toastInfoForElement(element);
                    element.style.display = "none";

                    if (message.length > 0) {
                        var previousTimeout = toastr.options.timeOut;
                        var previousExtendedTimeout = toastr.options.extendedTimeOut;

                        if (toastInfo.type === "info") {
                            toastr.options.timeOut = 7000;
                            toastr.options.extendedTimeOut = 2500;
                        } else {
                            toastr.options.timeOut = 0;
                            toastr.options.extendedTimeOut = 0;
                        }

                        toastr[toastInfo.type](message, toastInfo.title);
                        toastr.options.timeOut = previousTimeout;
                        toastr.options.extendedTimeOut = previousExtendedTimeout;
                    }
                }

                var toastSelector = ".summary-success, .summary-error, .validation-summary-errors, .alert-success, .alert-danger, .alert-warning, .alert-info";
                document.querySelectorAll(toastSelector).forEach(showToastFromElement);

                if (window.MutationObserver) {
                    var observer = new MutationObserver(function (mutations) {
                        mutations.forEach(function (mutation) {
                            Array.prototype.slice.call(mutation.addedNodes || []).forEach(function (node) {
                                if (!node || node.nodeType !== 1) {
                                    return;
                                }

                                if (node.matches && node.matches(toastSelector)) {
                                    showToastFromElement(node);
                                }

                                if (node.querySelectorAll) {
                                    node.querySelectorAll(toastSelector).forEach(showToastFromElement);
                                }
                            });
                        });
                    });

                    observer.observe(document.body, { childList: true, subtree: true });
                }
            }

            function enhanceRepositorySelects() {
                document.querySelectorAll("select.repositories").forEach(function (select) {
                    if (select.dataset.glassEnhanced === "true") {
                        return;
                    }

                    var wrapper = select.closest(".repo-selector") || select.parentElement;
                    var combo = document.createElement("div");
                    var toggle = document.createElement("button");
                    var label = document.createElement("span");
                    var icon = document.createElement("i");
                    var menu = document.createElement("div");

                    combo.className = "glass-combobox";
                    toggle.type = "button";
                    toggle.className = "glass-combobox-toggle";
                    toggle.setAttribute("aria-haspopup", "listbox");
                    toggle.setAttribute("aria-expanded", "false");

                    label.className = "glass-combobox-text";
                    icon.className = "fa-solid fa-chevron-down";
                    icon.setAttribute("aria-hidden", "true");

                    menu.className = "glass-combobox-menu";
                    menu.setAttribute("role", "listbox");

                    toggle.appendChild(label);
                    toggle.appendChild(icon);
                    combo.appendChild(toggle);
                    combo.appendChild(menu);

                    function selectedText() {
                        if (select.selectedIndex >= 0 && select.options[select.selectedIndex]) {
                            return select.options[select.selectedIndex].text;
                        }

                        return select.getAttribute("data-placeholder") || "Go to repository";
                    }

                    function closeCombo() {
                        combo.classList.remove("open");
                        toggle.setAttribute("aria-expanded", "false");
                    }

                    function openCombo() {
                        document.querySelectorAll(".glass-combobox.open").forEach(function (opened) {
                            if (opened !== combo) {
                                opened.classList.remove("open");
                                var openedToggle = opened.querySelector(".glass-combobox-toggle");
                                if (openedToggle) {
                                    openedToggle.setAttribute("aria-expanded", "false");
                                }
                            }
                        });

                        combo.classList.add("open");
                        toggle.setAttribute("aria-expanded", "true");
                    }

                    function refreshSelectedState() {
                        label.textContent = selectedText();

                        menu.querySelectorAll(".glass-combobox-option").forEach(function (item) {
                            item.classList.toggle("is-selected", Number(item.dataset.index) === select.selectedIndex);
                        });
                    }

                    Array.prototype.slice.call(select.options).forEach(function (option, index) {
                        var item = document.createElement("div");
                        var itemIcon = document.createElement("i");
                        var itemText = document.createElement("span");

                        item.className = "glass-combobox-option";
                        item.setAttribute("role", "option");
                        item.setAttribute("tabindex", "0");
                        item.dataset.index = index;

                        if (!option.value) {
                            item.classList.add("is-placeholder");
                            itemIcon.className = "fa-solid fa-compass";
                        } else {
                            itemIcon.className = "fa-solid fa-code-branch";
                        }

                        itemText.textContent = option.text;

                        item.appendChild(itemIcon);
                        item.appendChild(itemText);

                        function chooseOption() {
                            select.selectedIndex = index;
                            refreshSelectedState();
                            closeCombo();

                            if (!option.value) {
                                return;
                            }

                            var changeEvent;

                            if (typeof Event === "function") {
                                changeEvent = new Event("change", { bubbles: true });
                            } else {
                                changeEvent = document.createEvent("HTMLEvents");
                                changeEvent.initEvent("change", true, false);
                            }

                            select.dispatchEvent(changeEvent);
                        }

                        item.addEventListener("click", chooseOption);
                        item.addEventListener("keydown", function (event) {
                            if (event.key === "Enter" || event.key === " ") {
                                event.preventDefault();
                                chooseOption();
                            }
                        });

                        menu.appendChild(item);
                    });

                    toggle.addEventListener("click", function (event) {
                        event.preventDefault();

                        if (combo.classList.contains("open")) {
                            closeCombo();
                        } else {
                            openCombo();
                        }
                    });

                    toggle.addEventListener("keydown", function (event) {
                        if (event.key === "Escape") {
                            closeCombo();
                        }

                        if (event.key === "ArrowDown") {
                            event.preventDefault();
                            openCombo();
                            var selected = menu.querySelector(".glass-combobox-option.is-selected") || menu.querySelector(".glass-combobox-option");
                            if (selected) {
                                selected.focus();
                            }
                        }
                    });

                    document.addEventListener("click", function (event) {
                        if (!combo.contains(event.target)) {
                            closeCombo();
                        }
                    });

                    select.addEventListener("change", refreshSelectedState);

                    select.dataset.glassEnhanced = "true";
                    wrapper.classList.add("is-enhanced");
                    select.insertAdjacentElement("afterend", combo);
                    refreshSelectedState();
                });
            }

            function initSidebarToggle() {
                var toggle = document.getElementById("sidebarToggle");
                var storageKey = "bonobo.sidebar.collapsed";

                if (!toggle) {
                    return;
                }

                function applyState(collapsed, persist) {
                    document.body.classList.toggle("sidebar-collapsed", collapsed);
                    toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
                    toggle.setAttribute("aria-label", collapsed ? "Mostrar menú" : "Ocultar menú");
                    toggle.setAttribute("title", collapsed ? "Mostrar menú" : "Ocultar menú");

                    var icon = toggle.querySelector("i");
                    if (icon) {
                        icon.className = collapsed ? "fa-solid fa-angles-right" : "fa-solid fa-bars";
                    }

                    if (persist) {
                        try {
                            window.localStorage.setItem(storageKey, collapsed ? "true" : "false");
                        } catch (e) {
                            // En entornos restringidos, localStorage puede no estar disponible.
                        }
                    }
                }

                var collapsed = false;

                try {
                    collapsed = window.localStorage.getItem(storageKey) === "true";
                } catch (e) {
                    collapsed = false;
                }

                applyState(collapsed, false);

                toggle.addEventListener("click", function () {
                    applyState(!document.body.classList.contains("sidebar-collapsed"), true);
                });
            }

            function initPageTransitionLoader() {
                var hideTimer = null;
                var showTimer = null;

                if (window.BonoboPageLoader && window.BonoboPageLoader.initialized) {
                    return;
                }

                function getLoader() {
                    return document.getElementById("pageTransitionLoader");
                }

                function showLoader() {
                    var loader = getLoader();

                    if (!loader) {
                        return;
                    }

                    window.clearTimeout(showTimer);
                    window.clearTimeout(hideTimer);

                    showTimer = window.setTimeout(function () {
                        document.body.classList.add("is-page-loading");
                        loader.setAttribute("aria-hidden", "false");
                    }, 40);

                    hideTimer = window.setTimeout(hideLoader, 25000);
                }

                function hideLoader() {
                    var loader = getLoader();

                    window.clearTimeout(showTimer);
                    window.clearTimeout(hideTimer);
                    document.body.classList.remove("is-page-loading");

                    if (loader) {
                        loader.setAttribute("aria-hidden", "true");
                    }
                }

                window.BonoboPageLoader = {
                    initialized: true,
                    show: showLoader,
                    hide: hideLoader
                };

                function isModifiedClick(event) {
                    return event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey;
                }

                function shouldIgnoreElement(element) {
                    return !!(element && element.closest([
                        "[data-no-loader]",
                        ".sidebar-toggle",
                        ".glass-combobox-toggle",
                        ".glass-combobox-option",
                        ".commit-change-toggle",
                        ".blob-search button",
                        ".copy-to-clip-button",
                        ".more-commit-info-toggler",
                        ".dataTables_paginate a",
                        ".paginate_button"
                    ].join(",")));
                }

                function shouldShowForLink(link) {
                    var href = link.getAttribute("href");

                    if (!href || href.charAt(0) === "#" || shouldIgnoreElement(link)) {
                        return false;
                    }

                    if (link.target && link.target.toLowerCase() !== "_self") {
                        return false;
                    }

                    if (link.hasAttribute("download")) {
                        return false;
                    }

                    if (/^(javascript:|mailto:|tel:)/i.test(href)) {
                        return false;
                    }

                    try {
                        var url = new URL(link.href, window.location.href);

                        if (url.origin !== window.location.origin) {
                            return false;
                        }

                        return url.pathname !== window.location.pathname || url.search !== window.location.search;
                    } catch (e) {
                        return false;
                    }
                }

                document.addEventListener("click", function (event) {
                    if (isModifiedClick(event)) {
                        return;
                    }

                    var link = event.target.closest && event.target.closest("a[href]");
                    if (link && shouldShowForLink(link)) {
                        showLoader();
                    }
                }, true);

                document.addEventListener("submit", function (event) {
                    var form = event.target;

                    if (!form || shouldIgnoreElement(form) || (form.target && form.target.toLowerCase() !== "_self")) {
                        return;
                    }

                    if (form.checkValidity && !form.checkValidity()) {
                        hideLoader();
                        return;
                    }

                    showLoader();
                }, true);

                document.addEventListener("invalid", hideLoader, true);
                window.addEventListener("error", hideLoader);
                window.addEventListener("unhandledrejection", hideLoader);
                window.addEventListener("pageshow", hideLoader);
                window.addEventListener("pagehide", showLoader);

                if (document.querySelector(".validation-summary-errors, .field-validation-error")) {
                    hideLoader();
                }
            }

            function pullBackground() {
                var bgElement = document.getElementById("bg");

                if (!bgElement) {
                    return;
                }

                var ajaxRequest = new XMLHttpRequest();
                var corsProxy = "https://corsproxy.io/?";
                var targetUrl = encodeURIComponent("https://www.bing.com/HPImageArchive.aspx?format=xml&idx=0&n=1&mkt=en-US");

                ajaxRequest.open("GET", corsProxy + targetUrl, true);
                ajaxRequest.onreadystatechange = function () {
                    if (ajaxRequest.readyState !== 4 || ajaxRequest.status !== 200) {
                        return;
                    }

                    var parser = new DOMParser();
                    var xmlDoc = parser.parseFromString(ajaxRequest.responseText, "text/xml");
                    var urlTags = xmlDoc.getElementsByTagName("url");

                    if (urlTags.length > 0) {
                        bgElement.style.backgroundImage = "url('https://www.bing.com" + urlTags[0].textContent + "')";
                    }
                };

                ajaxRequest.onerror = function () {
                    bgElement.style.backgroundImage = "none";
                };

                ajaxRequest.send();
            }

            function initializeLayoutEnhancements() {
                initPageTransitionLoader();
                initSidebarToggle();
                enhanceRepositorySelects();
                applyBootstrapFormClasses();
                applyOutlineButtons();
                enhanceTables();
                initSystemToastr();
                pullBackground();
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initializeLayoutEnhancements);
            } else {
                initializeLayoutEnhancements();
            }
        })();

        (function () {
            if (window.BonoboPageLoader && window.BonoboPageLoader.initialized) {
                return;
            }

            var showTimer = null;
            var hideTimer = null;

            function loader() {
                return document.getElementById("pageTransitionLoader");
            }

            function show() {
                var element = loader();

                if (!element) {
                    return;
                }

                window.clearTimeout(showTimer);
                window.clearTimeout(hideTimer);
                showTimer = window.setTimeout(function () {
                    document.body.classList.add("is-page-loading");
                    element.setAttribute("aria-hidden", "false");
                }, 40);
                hideTimer = window.setTimeout(hide, 25000);
            }

            function hide() {
                var element = loader();

                window.clearTimeout(showTimer);
                window.clearTimeout(hideTimer);
                document.body.classList.remove("is-page-loading");

                if (element) {
                    element.setAttribute("aria-hidden", "true");
                }
            }

            function shouldShowForNavigationLink(anchor) {
                var href = anchor && anchor.getAttribute("href");

                if (!href || href.charAt(0) === "#" || anchor.target || anchor.hasAttribute("download")) {
                    return false;
                }

                if (anchor.closest("[data-no-loader], .commit-change-toggle, .copy-to-clip-button, .paginate_button")) {
                    return false;
                }

                if (/^(javascript:|mailto:|tel:)/i.test(href)) {
                    return false;
                }

                try {
                    var url = new URL(anchor.href, window.location.href);
                    return url.origin === window.location.origin &&
                        (url.pathname !== window.location.pathname || url.search !== window.location.search);
                } catch (e) {
                    return false;
                }
            }

            window.BonoboPageLoader = {
                initialized: true,
                show: show,
                hide: hide
            };

            if (!window.__bonoboPageLoaderFallbackBound) {
                window.__bonoboPageLoaderFallbackBound = true;

                document.addEventListener("click", function (event) {
                    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
                        return;
                    }

                    var anchor = event.target.closest && event.target.closest("a[href]");
                    if (anchor && shouldShowForNavigationLink(anchor)) {
                        show();
                    }
                }, true);

                document.addEventListener("submit", function (event) {
                    if (event.defaultPrevented || (event.target && event.target.target && event.target.target.toLowerCase() !== "_self")) {
                        return;
                    }

                    if (event.target && event.target.checkValidity && !event.target.checkValidity()) {
                        hide();
                        return;
                    }

                    show();
                }, true);

                document.addEventListener("invalid", hide, true);
                window.addEventListener("error", hide);
                window.addEventListener("unhandledrejection", hide);
                window.addEventListener("pageshow", hide);

                if (document.querySelector(".validation-summary-errors, .field-validation-error")) {
                    hide();
                }
            }
        })();
    </script>

    @RenderSection("scripts", required: false)
