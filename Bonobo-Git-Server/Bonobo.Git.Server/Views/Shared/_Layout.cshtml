<!DOCTYPE html>
<html lang="es">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="~/favicon.ico?v=2" type="image/x-icon" />
    <title>@ViewBag.Title :: @UserConfiguration.Current.GetSiteTitle()</title>

    @Styles.Render("~/Content/bundledCss")
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/highlightjs/monokai-sublime.min.css")?v=11.11.1" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")?v=blob-viewer-20260601g" />

    <!-- Librerías locales agregadas al proyecto -->
    <link rel="stylesheet" href="@Url.Content("~/Librerias/NormalizeCss/normalize.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Librerias/FontawesomeFree/fontawesome.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Librerias/JsBootstrapBundle/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Librerias/JsDatatables/jquery.dataTables.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Librerias/JsSweetalert2/sweetalert2.min.css")" />

    @if (UserConfiguration.Current.HasCustomSiteCss)
    {
        <link rel="stylesheet" href="@string.Format("{0}?_={1}", Url.Content(UserConfiguration.Current.SiteCssUrl), DateTime.Now.Ticks)" type="text/css" />
    }

    @if (UserConfiguration.Current.HasCustomSiteLogo)
    {
        <style>
            .app-brand-logo {
                background: url('@Url.Content(UserConfiguration.Current.SiteLogoUrl)') no-repeat center center;
                background-size: contain;
            }
        </style>
    }

    <style>
        :root {
            --bg-dark: #07111f;
            --bg-panel: rgba(12, 22, 35, 0.62);
            --bg-panel-strong: rgba(12, 22, 35, 0.78);
            --bg-panel-soft: rgba(255, 255, 255, 0.08);
            --border-glass: rgba(255, 255, 255, 0.16);
            --border-glass-strong: rgba(255, 255, 255, 0.26);
            --text-main: #f8fafc;
            --text-muted: #cbd5e1;
            --accent: #60a5fa;
            --accent-strong: #3b82f6;
            --danger: #fb7185;
            --success: #34d399;
            --sidebar-width: 292px;
            --content-max-width: 1600px;
            --blur: 18px;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            color: var(--text-main);
            font-family: "Inter", "Segoe UI", Roboto, Arial, sans-serif;
            background: radial-gradient(circle at 18% 20%, rgba(96, 165, 250, 0.28), transparent 28%), radial-gradient(circle at 85% 8%, rgba(245, 158, 11, 0.22), transparent 30%), linear-gradient(135deg, #08111f 0%, #162033 48%, #0b1220 100%);
            overflow-x: hidden;
        }

            body::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -3;
                background: rgba(2, 6, 23, 0.18);
                pointer-events: none;
            }

        #bg {
            min-height: 100vh;
            width: 100%;
            background-size: cover;
            background-position: center center;
            background-attachment: fixed;
            transition: background-image 700ms ease-in-out;
            position: relative;
        }

            #bg::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                background: linear-gradient(90deg, rgba(2, 6, 23, 0.80) 0%, rgba(2, 6, 23, 0.34) 34%, rgba(2, 6, 23, 0.18) 100%), linear-gradient(180deg, rgba(2, 6, 23, 0.22) 0%, rgba(2, 6, 23, 0.45) 100%);
                pointer-events: none;
            }

        .app-layout {
            display: flex;
            min-height: 100vh;
            align-items: stretch;
        }

        .sidebar-toggle {
            position: fixed;
            top: 50%;
            left: 0;
            z-index: 2500;
            width: 30px;
            height: 56px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #e2e8f0;
            background: rgba(15, 23, 42, 0.58);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-left: 0;
            border-radius: 0 14px 14px 0;
            box-shadow: 8px 12px 28px rgba(0, 0, 0, 0.24);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            cursor: pointer;
            opacity: 0.78;
            transform: translateY(-50%);
            transition: width 170ms ease, opacity 170ms ease, background-color 170ms ease, border-color 170ms ease, transform 170ms ease;
        }

            .sidebar-toggle:hover,
            .sidebar-toggle:focus {
                color: #ffffff;
                width: 36px;
                opacity: 1;
                background: rgba(59, 130, 246, 0.36);
                border-color: rgba(147, 197, 253, 0.45);
                outline: none;
                transform: translateY(-50%) translateX(0);
            }

        body.sidebar-collapsed .sidebar-toggle {
            left: 0;
        }

        .app-sidebar {
            width: var(--sidebar-width);
            flex: 0 0 var(--sidebar-width);
            padding: 22px 14px 22px 14px;
            position: sticky;
            top: 0;
            align-self: flex-start;
            height: 100vh;
            overflow-y: auto;
            overflow-x: hidden;
            transition: width 240ms ease, flex-basis 240ms ease, padding 240ms ease, opacity 200ms ease;
        }

            .app-sidebar::-webkit-scrollbar {
                width: 8px;
            }

            .app-sidebar::-webkit-scrollbar-thumb {
                background: rgba(148, 163, 184, 0.28);
                border-radius: 999px;
            }

        body.sidebar-collapsed .app-sidebar {
            width: 0;
            flex-basis: 0;
            padding-left: 0;
            padding-right: 0;
            opacity: 0;
            pointer-events: none;
        }

        .sidebar-glass,
        .glass-content,
        .app-footer {
            background: var(--bg-panel);
            border: 1px solid var(--border-glass);
            box-shadow: 0 18px 55px rgba(0, 0, 0, 0.34);
            backdrop-filter: blur(var(--blur));
            -webkit-backdrop-filter: blur(var(--blur));
        }

        .sidebar-glass {
            min-height: calc(100vh - 44px);
            border-radius: 0 24px 24px 0;
            padding: 18px 14px;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.78) 0%, rgba(2, 6, 23, 0.62) 100%);
            transition: transform 240ms ease, opacity 200ms ease;
        }

        body.sidebar-collapsed .sidebar-glass {
            transform: translateX(-115%);
            opacity: 0;
        }

        .brand-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 54px;
            padding: 8px 10px 16px 10px;
            margin-bottom: 16px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        }

        .app-brand-logo {
            width: 34px;
            height: 34px;
            min-width: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            color: #ff5548;
            background: rgba(255, 255, 255, 0.08);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12);
        }

            .app-brand-logo i {
                font-size: 1.45rem;
            }

        .brand-title {
            color: #ffffff;
            font-size: 1.03rem;
            font-weight: 700;
            letter-spacing: 0.01em;
            text-decoration: none;
            line-height: 1.22;
        }

            .brand-title:hover,
            .brand-title:focus {
                color: #ffffff;
                text-decoration: none;
            }

        .repo-selector {
            margin: 0 4px 18px 4px;
        }

        .glass-label {
            display: block;
            margin-bottom: 7px;
            color: var(--text-muted);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .glass-select,
        .glass-content select,
        .glass-content textarea,
        .glass-content input[type="text"],
        .glass-content input[type="password"],
        .glass-content input[type="email"],
        .glass-content input[type="search"],
        .glass-content input[type="number"],
        .glass-content input[type="url"],
        .glass-content .form-control,
        .glass-content .form-select {
            color: #ffffff !important;
            background-color: rgba(2, 6, 23, 0.42) !important;
            border: 1px solid rgba(255, 255, 255, 0.26) !important;
            border-radius: 12px !important;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 8px 25px rgba(0, 0, 0, 0.14) !important;
            outline: none !important;
        }

        .glass-content input,
        .glass-content select,
        .glass-content textarea {
            transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
        }

        .glass-content input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]):hover,
        .glass-content select:hover,
        .glass-content textarea:hover {
            border-color: rgba(147, 197, 253, 0.46) !important;
            transform: translateY(-1px);
        }

        .glass-select {
            min-height: 42px;
        }

            .glass-select option,
            .glass-content select option,
            .glass-content .form-select option {
                color: #111827;
                background: #ffffff;
            }

            .glass-content input:focus,
            .glass-content select:focus,
            .glass-content textarea:focus,
            .glass-select:focus,
            .glass-content .form-control:focus,
            .glass-content .form-select:focus {
                border-color: rgba(96, 165, 250, 0.82) !important;
                box-shadow: 0 0 0 0.18rem rgba(59, 130, 246, 0.22) !important;
                transform: translateY(-1px);
            }

        .repo-selector.is-enhanced {
            position: relative;
        }

            .repo-selector.is-enhanced select.repositories {
                position: absolute !important;
                width: 1px !important;
                height: 1px !important;
                opacity: 0 !important;
                pointer-events: none !important;
                overflow: hidden !important;
            }

        .glass-combobox {
            position: relative;
            width: 100%;
        }

        .glass-combobox-toggle {
            width: 100%;
            min-height: 42px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 10px 12px;
            color: #ffffff;
            background: rgba(2, 6, 23, 0.44);
            border: 1px solid rgba(255, 255, 255, 0.24);
            border-radius: 14px;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 10px 26px rgba(0, 0, 0, 0.18);
            font-weight: 750;
            line-height: 1.2;
            text-align: left;
            cursor: pointer;
            transition: background-color 170ms ease, border-color 170ms ease, box-shadow 170ms ease;
        }

            .glass-combobox-toggle:hover,
            .glass-combobox-toggle:focus {
                background: rgba(15, 23, 42, 0.66);
                border-color: rgba(96, 165, 250, 0.65);
                box-shadow: 0 0 0 0.18rem rgba(59, 130, 246, 0.18), 0 12px 28px rgba(0, 0, 0, 0.18);
                outline: none;
            }

            .glass-combobox-toggle i {
                color: rgba(191, 219, 254, 0.92);
                font-size: 0.9rem;
                transition: transform 160ms ease;
            }

        .glass-combobox.open .glass-combobox-toggle i {
            transform: rotate(180deg);
        }

        .glass-combobox-menu {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            z-index: 3200;
            display: none;
            max-height: 290px;
            padding: 7px;
            overflow-y: auto;
            background: rgba(15, 23, 42, 0.94);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 16px;
            box-shadow: 0 20px 46px rgba(0, 0, 0, 0.38);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .glass-combobox.open .glass-combobox-menu {
            display: block;
        }

        .glass-combobox-option {
            min-height: 38px;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 10px;
            color: rgba(241, 245, 249, 0.90);
            border: 1px solid transparent;
            border-radius: 12px;
            font-weight: 650;
            cursor: pointer;
            user-select: none;
        }

            .glass-combobox-option:hover,
            .glass-combobox-option:focus {
                color: #ffffff;
                background: rgba(96, 165, 250, 0.18);
                border-color: rgba(147, 197, 253, 0.22);
                outline: none;
            }

            .glass-combobox-option.is-selected {
                color: #ffffff;
                background: rgba(59, 130, 246, 0.28);
                border-color: rgba(147, 197, 253, 0.30);
            }

            .glass-combobox-option.is-placeholder {
                color: rgba(203, 213, 225, 0.72);
            }

            .glass-combobox-option i {
                width: 18px;
                color: rgba(147, 197, 253, 0.95);
                text-align: center;
            }

        .glass-combobox-menu::-webkit-scrollbar {
            width: 8px;
        }

        .glass-combobox-menu::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.35);
            border-radius: 999px;
        }

        .sidebar-section-title {
            color: rgba(226, 232, 240, 0.82);
            font-size: 0.72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.12em;
            margin: 20px 10px 8px 10px;
        }

        .sidebar-nav {
            gap: 6px;
        }

            .sidebar-nav .nav-link {
                display: flex;
                align-items: center;
                gap: 10px;
                min-height: 42px;
                padding: 10px 12px;
                color: rgba(241, 245, 249, 0.88);
                border: 1px solid transparent;
                border-radius: 14px;
                font-weight: 650;
                transition: background-color 170ms ease, border-color 170ms ease, color 170ms ease, transform 170ms ease;
            }

                .sidebar-nav .nav-link i {
                    width: 20px;
                    text-align: center;
                    color: rgba(147, 197, 253, 0.92);
                }

                .sidebar-nav .nav-link:hover,
                .sidebar-nav .nav-link:focus {
                    color: #ffffff;
                    text-decoration: none;
                    background: rgba(255, 255, 255, 0.10);
                    border-color: rgba(255, 255, 255, 0.14);
                    transform: translateX(2px);
                }

        body.Repository .sidebar-nav .repository,
        body.Account .sidebar-nav .users,
        body.Team .sidebar-nav .teams,
        body.Settings .sidebar-nav .settings,
        body.SystemLogs .sidebar-nav .logs {
            color: #ffffff;
            background: rgba(59, 130, 246, 0.24);
            border-color: rgba(96, 165, 250, 0.34);
        }

        .sidebar-divider {
            height: 1px;
            margin: 16px 8px;
            background: rgba(255, 255, 255, 0.11);
        }

        .app-main {
            flex: 1 1 auto;
            min-width: 0;
            display: flex;
            flex-direction: column;
            transition: margin 240ms ease;
        }

        .app-content-wrap {
            flex: 1 1 auto;
            padding: 18px 8px 18px 8px;
            transition: padding 240ms ease;
        }

        body.sidebar-collapsed .app-content-wrap {
            padding-left: 56px;
            padding-right: 8px;
        }

        .glass-content {
            width: 100%;
            min-height: calc(100vh - 160px);
            margin: 0;
            padding: clamp(16px, 1.5vw, 24px);
            border-radius: 20px;
            background: linear-gradient(180deg, rgba(15, 23, 42, 0.66) 0%, rgba(15, 23, 42, 0.54) 100%);
            font-size: 0.94rem;
            transition: width 240ms ease, max-width 240ms ease, padding 240ms ease;
        }

        body.sidebar-collapsed .glass-content {
            width: 100%;
        }

        .glass-content h1,
        .glass-content h2,
        .glass-content h3,
        .glass-content h4,
        .glass-content h5,
        .glass-content h6,
        .glass-content label,
        .glass-content legend {
            color: #ffffff;
            text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
        }

        .glass-content h1 {
            margin-top: 0;
            margin-bottom: 1.05rem;
            font-size: clamp(1.75rem, 2.15vw, 2.35rem);
            line-height: 1.12;
            letter-spacing: -0.025em;
        }

        .glass-content h2 {
            font-size: clamp(1.35rem, 1.6vw, 1.72rem);
            line-height: 1.18;
        }

        .glass-content h3 {
            font-size: clamp(1.12rem, 1.25vw, 1.36rem);
            line-height: 1.22;
        }

        .glass-content h4 {
            font-size: 1.04rem;
        }

        .glass-content h5 {
            font-size: 0.96rem;
        }

        .glass-content h6 {
            font-size: 0.9rem;
        }

        .glass-content .page-header {
            margin-top: 0;
            margin-bottom: 18px;
            padding-bottom: 12px;
        }

            .glass-content .page-header h1,
            .glass-content .page-header h2 {
                margin-bottom: 0;
            }

        .glass-content p,
        .glass-content span,
        .glass-content li,
        .glass-content td,
        .glass-content th,
        .glass-content small,
        .glass-content .help-block,
        .glass-content .text-muted {
            color: rgba(241, 245, 249, 0.88);
        }

        .glass-content a:not(.btn) {
            color: #93c5fd;
            text-decoration: none;
        }

            .glass-content a:not(.btn):hover {
                color: #bfdbfe;
                text-decoration: underline;
            }

        .glass-content .page-header,
        .glass-content .form-actions,
        .glass-content hr {
            border-color: rgba(255, 255, 255, 0.16) !important;
        }

        .glass-content .well,
        .glass-content .panel,
        .glass-content .panel-default,
        .glass-content .list-group-item,
        .glass-content .card {
            color: #ffffff;
            background: rgba(15, 23, 42, 0.46) !important;
            border-color: rgba(255, 255, 255, 0.14) !important;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
        }

        .glass-content .panel-heading,
        .glass-content .panel-footer,
        .glass-content .card-header,
        .glass-content .card-footer {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.07) !important;
            border-color: rgba(255, 255, 255, 0.14) !important;
        }

        .view-toolbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 18px;
        }

        .view-toolbar h1 {
            margin-bottom: 0;
        }

        .view-actions,
        .form-actions-glass {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        .glass-section {
            margin-bottom: 18px;
            padding: 18px;
            background: rgba(15, 23, 42, 0.34);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 18px;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
        }

        .table-glass-wrap {
            width: 100%;
            margin: 0 0 18px 0;
            overflow-x: auto;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 18px;
            background: rgba(15, 23, 42, 0.24);
        }

        .table-glass-wrap table {
            margin: 0;
            min-width: 720px;
        }

        .table-glass-wrap .dataTables_wrapper {
            padding: 14px 16px 0 16px;
        }

        .table-glass-wrap table.dataTable {
            margin-top: 14px !important;
            margin-bottom: 0 !important;
        }

        .glass-content table,
        .glass-content .table,
        .glass-content .dataTable {
            width: 100%;
            color: #f8fafc !important;
            border-color: rgba(255, 255, 255, 0.14) !important;
        }

            .glass-content table thead th,
            .glass-content .table thead th,
            .glass-content .dataTable thead th {
                color: #dbeafe !important;
                background: linear-gradient(180deg, rgba(96, 165, 250, 0.34) 0%, rgba(30, 41, 59, 0.72) 100%) !important;
                border-color: rgba(147, 197, 253, 0.22) !important;
                border-bottom: 1px solid rgba(191, 219, 254, 0.28) !important;
                font-size: 0.95rem;
                font-weight: 800;
                letter-spacing: 0.018em;
                text-shadow: 0 1px 8px rgba(0, 0, 0, 0.36);
                padding: 12px 14px;
                white-space: nowrap;
            }

            .glass-content table tbody tr,
            .glass-content .table tbody tr,
            .glass-content .dataTable tbody tr {
                background: rgba(15, 23, 42, 0.30) !important;
                transition: background-color 160ms ease, box-shadow 160ms ease;
            }

                .glass-content table tbody tr:hover,
                .glass-content .table tbody tr:hover,
                .glass-content .dataTable tbody tr:hover {
                    background: rgba(255, 255, 255, 0.09) !important;
                    box-shadow: inset 3px 0 0 rgba(96, 165, 250, 0.62);
                }

            .glass-content table td,
            .glass-content table th,
            .glass-content .table td,
            .glass-content .table th {
                border-color: rgba(255, 255, 255, 0.13) !important;
                vertical-align: middle;
            }

            .glass-content table tbody td,
            .glass-content .table tbody td,
            .glass-content .dataTable tbody td {
                color: rgba(241, 245, 249, 0.92) !important;
                font-size: 0.94rem;
                padding: 12px 14px;
            }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            color: rgba(241, 245, 249, 0.88) !important;
        }

        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_filter {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            font-weight: 700;
        }

        .dataTables_wrapper .dataTables_filter {
            justify-content: flex-end;
        }

        .dataTables_wrapper .dataTables_length label,
        .dataTables_wrapper .dataTables_filter label {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            color: rgba(241, 245, 249, 0.92);
            white-space: nowrap;
        }

        .dataTables_wrapper .dataTables_length select {
            min-width: 58px;
            min-height: 36px;
            padding: 4px 28px 4px 12px;
            border-radius: 14px !important;
        }

        .dataTables_wrapper .dataTables_filter input {
            min-width: 220px;
            min-height: 38px;
            padding: 7px 12px;
            border-radius: 14px !important;
        }

        .dataTables_wrapper .dataTables_info {
            padding: 12px 0 14px 0 !important;
            font-weight: 650;
        }

        .dataTables_wrapper .dataTables_paginate {
            padding-top: 6px !important;
            padding-bottom: 10px;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button {
                color: #ffffff !important;
                border: 1px solid rgba(255, 255, 255, 0.18) !important;
                border-radius: 10px !important;
                background: rgba(255, 255, 255, 0.06) !important;
                margin-left: 5px !important;
                padding: 8px 13px !important;
                transition: transform 160ms ease, background-color 160ms ease, border-color 160ms ease, color 160ms ease;
            }

                .dataTables_wrapper .dataTables_paginate .paginate_button.current,
                .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                    color: #ffffff !important;
                    border-color: rgba(96, 165, 250, 0.55) !important;
