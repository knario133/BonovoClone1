@using System.Collections.Concurrent
@model Bonobo.Git.Server.Models.LogOnModel
@{
    ViewBag.Title = @Resources.Home_LogOn_Title;
}

<div class="logon-container">
    <div class="glass-card" style="max-width: 400px; width: 100%;">
        <h1 style="text-align: center; margin-bottom: 1.5rem;">@Resources.Home_LogOn_Title</h1>

        @using (Html.BeginForm("LogOn", "Home", FormMethod.Post, new { @class = "pure-form pure-form-aligned", style = "display: flex; flex-direction: column; gap: 1rem;" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, Resources.Home_LogOn_Failed, new { style = "color: #ef4444;" })

            <fieldset style="border: none; padding: 0; margin: 0;">
                <div class="pure-control-group" style="margin-bottom: 1rem;">
                    @Html.LabelFor(m => m.Username, new { style = "display: block; margin-bottom: 0.5rem;" })
                    @Html.TextBoxFor(m => m.Username, new { autofocus = "", style = "width: 100%; padding: 0.5rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: #fff;" })
                    <div style="color: #ef4444; font-size: 0.875rem;">@Html.ValidationMessageFor(m => m.Username)</div>
                </div>
                <div class="pure-control-group" style="margin-bottom: 1rem;">
                    @Html.LabelFor(m => m.Password, new { accesskey = "p", style = "display: block; margin-bottom: 0.5rem;" })
                    @Html.PasswordFor(m => m.Password, new { @class = "textInput small", style = "width: 100%; padding: 0.5rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: #fff;" })
                    <div style="color: #ef4444; font-size: 0.875rem;">@Html.ValidationMessageFor(m => m.Password)</div>
                </div>
                <div class="pure-control-group" style="margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
                    @Html.CheckBoxFor(m => m.RememberMe)
                    @Html.LabelFor(m => m.RememberMe, new { style = "margin: 0;" })
                    <div style="color: #ef4444; font-size: 0.875rem;">@Html.ValidationMessageFor(m => m.RememberMe)</div>
                </div>
                @Html.HiddenFor(m => m.ReturnUrl)
                @if (Model.DatabaseResetCode != 0)
                {
                    @Html.TextBoxFor(m => m.DatabaseResetCode, new { style = "width: 100%; padding: 0.5rem; border-radius: 4px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: #fff; margin-bottom: 1rem;" })
                }
                <div class="pure-controls" style="margin-top: 1.5rem; text-align: center;">
                    <button type="submit" class="pure-button pure-button-primary" style="width: 100%; padding: 0.75rem; border-radius: 4px; background: #3b82f6; color: #fff; border: none; font-weight: bold; cursor: pointer;"><i class="fa fa-sign-in"></i> @Resources.Home_LogOn_LogOn</button>
                </div>
                <div class="pure-controls" style="margin-top: 1rem; text-align: center; font-size: 0.875rem;">
                    @Html.ActionLink(Resources.Home_LogOn_ForgotPassword, "ForgotPassword", null, new { style = "color: #93c5fd;" })
                </div>
            </fieldset>
        }
    </div>
</div>
